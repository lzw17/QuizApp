page {
  background: #edf1f7;
  color: #17233d;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #edf1f7;
  padding-bottom: env(safe-area-inset-bottom);
}

.hero {
  box-sizing: border-box;
  padding: 36rpx 42rpx 74rpx;
  background: #18294b;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 32rpx;
  margin-bottom: 54rpx;
}

.hero-kicker,
.hero-status,
.section-eyebrow {
  font-size: 20rpx;
  line-height: 1.4;
  color: #9db2d7;
}

.hero-status {
  color: #c5d2e8;
}

.brand {
  display: flex;
  align-items: center;
}

.logo-wrap {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #294b83;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 30rpx;
}

.logo-img {
  width: 88rpx;
  height: 88rpx;
}

.brand-copy {
  min-width: 0;
  margin-left: 26rpx;
}

.app-name {
  display: block;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #fff;
}

.app-desc {
  display: block;
  max-width: 520rpx;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #c5d2e8;
  white-space: normal;
  word-break: break-all;
}

.hero-note {
  display: block;
  margin-top: 42rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #d9e2f2;
}

.sheet {
  position: relative;
  box-sizing: border-box;
  min-height: 520rpx;
  margin: -28rpx 24rpx 0;
  padding: 28rpx 34rpx 52rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(24, 41, 75, 0.08);
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 34rpx;
  border-radius: 8rpx;
  background: #dce2ec;
}

.section-heading {
  margin-bottom: 36rpx;
}

.section-eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: #6d83ad;
}

.card-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #17233d;
}

.section-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #718096;
}

.feature-grid {
  display: flex;
  margin-bottom: 42rpx;
  border: 1rpx solid #e6ebf3;
  border-radius: 18rpx;
  overflow: hidden;
}

.feature-item {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 24rpx 18rpx 22rpx;
  border-right: 1rpx solid #e6ebf3;
}

.feature-item:last-child {
  border-right: 0;
}

.feature-index {
  display: block;
  margin-bottom: 16rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #4c72c9;
}

.feature-title,
.feature-meta {
  display: block;
  white-space: normal;
  word-break: break-all;
}

.feature-title {
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #263653;
}

.feature-meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #8b98ad;
}

.btn-wx-login,
.btn-submit {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  padding: 0;
  border: none;
  border-radius: 16rpx;
  font-size: 31rpx;
  line-height: 96rpx;
  font-weight: 600;
}

.btn-wx-login {
  margin: 0 0 22rpx;
  background: #1ea96a;
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(30, 169, 106, 0.2);
}

.btn-wx-login::after,
.btn-submit::after,
.avatar-btn::after {
  border: none;
}

.btn-wx-login-hover {
  background: #178e58;
}

.btn-wx-login.loading,
.btn-submit.loading {
  opacity: 0.62;
}

.wx-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-mark {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  color: #1ea96a;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.privacy-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a2adbd;
}

.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: -4rpx 0 42rpx;
}

.avatar-container {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin-bottom: 18rpx;
}

.avatar-btn {
  width: 176rpx;
  height: 176rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.avatar-btn-hover {
  opacity: 0.78;
}

.avatar-img,
.avatar-empty,
.avatar-fallback {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
}

.avatar-img {
  border: 4rpx solid #dbe5f7;
  box-sizing: border-box;
}

.avatar-empty {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eef3ff;
  border: 2rpx dashed #9fb5e8;
}

.avatar-fallback {
  overflow: hidden;
}

.avatar-plus {
  display: block;
  font-size: 58rpx;
  line-height: 0.9;
  font-weight: 300;
  color: #5576c5;
}

.avatar-empty-label {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5576c5;
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: #4169d8;
}

.badge-icon {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

.avatar-label,
.avatar-sub {
  display: block;
  max-width: 100%;
  text-align: center;
  line-height: 1.5;
}

.avatar-label {
  font-size: 25rpx;
  color: #52627d;
}

.avatar-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa6b8;
}

.field {
  margin-bottom: 36rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #263653;
}

.field-input {
  display: block;
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 2rpx solid #dfe6f1;
  border-radius: 16rpx;
  background: #f8fafd;
  color: #1d2a42;
  font-size: 30rpx;
  line-height: 96rpx;
}

.field-placeholder {
  color: #9ba8ba;
  font-size: 27rpx;
  line-height: 96rpx;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8b98aa;
}

.btn-submit {
  margin: 0 0 24rpx;
  background: #4169d8;
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(65, 105, 216, 0.2);
}

.btn-submit-hover {
  background: #3459be;
}
