# 不用 Docker 的部署方式：systemd 守护 uvicorn
#
# ⚠️ 本文件是「不用宝塔、项目在 /opt/quizapp」的通用布局。
#    宝塔面板托管的项目（本项目线上布局）请用 quizapp-api.service.example +
#    quizapp-worker.service.example，路径/用户/解释器都不一样，不能混用。
#
# 使用步骤（服务器上执行）：
#   1. 假设项目放在 /opt/quizapp
#      cd /opt/quizapp/backend
#      python3 -m venv .venv
#      .venv/bin/pip install -r requirements-prod.txt -i https://pypi.tuna.tsinghua.edu.cn/simple
#   2. cp .env.production.example .env 并填写完整
#      （DATABASE_URL 中的主机改为 127.0.0.1，UPLOAD_DIR 改为
#       /var/lib/quizapp/uploads）
#   3. 修改下方 User / 路径后：
#      sudo cp ../deploy/quizapp.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now quizapp
#   4. 查看状态与日志：
#      systemctl status quizapp
#      journalctl -u quizapp -f

[Unit]
Description=智题学习笔记 FastAPI backend
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=quizapp
Group=quizapp
WorkingDirectory=/opt/quizapp/backend
EnvironmentFile=/opt/quizapp/backend/.env
ExecStart=/opt/quizapp/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StateDirectory=quizapp
StateDirectoryMode=0750
ReadWritePaths=/var/lib/quizapp

[Install]
WantedBy=multi-user.target
