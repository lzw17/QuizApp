# 应用配置
APP_NAME=智题学习笔记
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_ISSUER=quizapp-api
DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# 本地开发默认启用固定身份登录，不请求微信 code2Session。
# 生产环境必须使用 .env.production.example，且 MOCK 必须为 false。
WX_APPID=wxaec3bef13eea7842
WX_SECRET=
WX_MOCK_LOGIN=true
WX_MOCK_OPENID=local-dev-user
WX_MOCK_ADMIN=true
# 管理员 OpenID，多个值用英文逗号分隔（仅保存在后端）
ADMIN_OPENIDS=
AUTH_TOKEN_EXPIRE_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 数据库配置：本地开发默认使用 SQLite
DATABASE_URL=sqlite:///./quiz_app.db
# 生产环境使用 MySQL 时替换为类似下面的连接地址
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/quiz_app

# OpenAI 兼容模型。BASE_URL 填 API 根地址，不要填 /chat/completions。
# 三项必须一起填写；生产必须 HTTPS。均留空时整体回退到 DEEPSEEK_*。
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# 旧部署兼容项：未配置对应 LLM_* 时才会使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MinerU 文档解析 API（可选，有则用，无则降级到 PyPDF）
MINERU_API_KEY=your-mineru-api-key
MINERU_API_URL=https://mineru.net/api/v4

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_URL_CONTENT_MB=10
MAX_DOCX_ENTRIES=2000
MAX_DOCX_TOTAL_UNCOMPRESSED_MB=100
MAX_DOCX_SINGLE_ENTRY_MB=20
MAX_DOCX_COMPRESSION_RATIO=200
MAX_PDF_PAGES=300
MAX_EXTRACTED_TEXT_CHARS=1000000
TASK_STALE_MINUTES=60
MAX_GENERATION_CHUNKS=100
MAX_GENERATED_QUESTIONS=500
MAX_ACTIVE_GENERATION_TASKS=2
MAX_CONCURRENT_GENERATION_TASKS=2
MAX_DAILY_GENERATION_TASKS=10
MIN_GENERATION_INTERVAL_SECONDS=30
GENERATION_TIMEOUT_SECONDS=1800
GENERATION_BATCH_TIMEOUT_SECONDS=180
GENERATION_BATCH_MAX_RETRIES=2
MIN_PARTIAL_GENERATED_QUESTIONS=5
GENERATION_CHUNK_SIZE=1500
GENERATION_CHUNK_OVERLAP=150
GENERATION_CHUNK_CONCURRENCY=3

# 本地不依赖 Redis；生产环境必须使用 arq。
GENERATION_QUEUE_MODE=in_process
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE_NAME=quizapp:generation

# 仅浏览器调试受 CORS 约束；微信小程序仍以合法域名配置为准。
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
