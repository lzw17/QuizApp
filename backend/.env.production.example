# 生产环境配置模板
# 用法：复制为 backend/.env 并逐项填写，所有 <CHANGE_ME> 必须替换
# 注意：config.py 的 validate_runtime_security() 会在启动时校验以下项，
#       任何一项不满足，服务将拒绝启动：
#       - APP_ENV=production 时 WX_APPID / WX_SECRET 必填
#       - SECRET_KEY 长度 >= 32
#       - DEBUG 必须为 false
#       - ALLOWED_ORIGINS 不能为 *
#       - DATABASE_URL 不能是 SQLite
#       - PUBLIC_BASE_URL 必须是 HTTPS 地址

APP_NAME=智题学习笔记
APP_ENV=production
# 生成方式：openssl rand -hex 32
SECRET_KEY=<CHANGE_ME_至少32位随机字符串>
JWT_ISSUER=quizapp-api
DEBUG=false

# 数据库（Docker Compose 内主机名为 mysql；systemd 部署改为 127.0.0.1）
DATABASE_URL=mysql+pymysql://quizapp:<CHANGE_ME_DB密码>@mysql:3306/quizapp?charset=utf8mb4

# Redis（Docker Compose 内主机名为 redis；systemd 部署改为 127.0.0.1）
REDIS_URL=redis://redis:6379/0

# 微信小程序（微信公众平台 - 开发管理 - 开发设置中获取）
WX_APPID=<你的AppID>
WX_SECRET=<你的AppSecret>
WX_MOCK_LOGIN=false
WX_MOCK_ADMIN=false
# 管理员微信 OpenID，多个用英文逗号分隔
ADMIN_OPENIDS=
AUTH_TOKEN_EXPIRE_DAYS=30
# 对外访问地址，必须是 HTTPS 且与白名单域名一致
PUBLIC_BASE_URL=https://api.quizapp.chat

# DeepSeek
DEEPSEEK_API_KEY=<你的DeepSeek Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MinerU PDF 解析（可选，留空则降级 PyPDF）
MINERU_API_KEY=
MINERU_API_URL=https://mineru.net/api/v4

# 文件上传（Docker 内固定 /app/uploads，已挂载宿主机 uploads/ 目录）
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
MAX_URL_CONTENT_MB=10
TASK_STALE_MINUTES=60
MAX_GENERATION_CHUNKS=100
MAX_GENERATED_QUESTIONS=500
MAX_ACTIVE_GENERATION_TASKS=2
MAX_CONCURRENT_GENERATION_TASKS=2
GENERATION_TIMEOUT_SECONDS=900

# CORS：生产必须为明确域名列表，不能是 *
ALLOWED_ORIGINS=https://servicewechat.com
