# 生产环境配置模板
# 用法：复制为 backend/.env 并逐项填写，所有 <CHANGE_ME> 必须替换
# 注意：config.py 的 validate_runtime_security() 会在启动时校验以下项，
#       任何一项不满足，服务将拒绝启动：
#       - APP_ENV=production 时 WX_APPID / WX_SECRET 必填
#       - SECRET_KEY 长度 >= 32
#       - DEBUG 必须为 false
#       - ALLOWED_ORIGINS 不能为 *
#       - DATABASE_URL 不能是 SQLite
#       - PUBLIC_BASE_URL 和 LLM_BASE_URL 必须是 HTTPS 地址

APP_NAME=智题学习笔记
APP_ENV=production
# 生成方式：openssl rand -hex 32
SECRET_KEY=<CHANGE_ME_至少32位随机字符串>
JWT_ISSUER=quizapp-api
DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# 宝塔直部署使用本机 MySQL。密码含 @、:、/、# 等字符时必须先 URL 编码。
DATABASE_URL=mysql+pymysql://quizapp:<CHANGE_ME_DB密码>@127.0.0.1:3306/quizapp?charset=utf8mb4

# 微信小程序（微信公众平台 - 开发管理 - 开发设置中获取）
WX_APPID=wxaec3bef13eea7842
WX_SECRET=<你的AppSecret>
WX_MOCK_LOGIN=false
WX_MOCK_ADMIN=false
# 管理员微信 OpenID，多个用英文逗号分隔
ADMIN_OPENIDS=
AUTH_TOKEN_EXPIRE_DAYS=30
# 对外访问地址，必须是 HTTPS 且与白名单域名一致
PUBLIC_BASE_URL=https://api.quizapp.chat

# OpenAI 兼容模型。模板默认与小程序隐私页披露的 DeepSeek 保持一致。
# 切换服务商前必须同步更新小程序隐私页和微信后台《用户隐私保护指引》。
LLM_API_KEY=<CHANGE_ME_新生成的模型API密钥>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# 旧 DeepSeek 部署兼容项：三个 LLM 核心项均未配置时才会使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MinerU PDF 解析（可选，留空则降级 PyPDF）
MINERU_API_KEY=
MINERU_API_URL=https://mineru.net/api/v4

# 宝塔服务器持久化目录，不要放在 backend/app 下。
UPLOAD_DIR=/www/wwwroot/quizapp/uploads
MAX_FILE_SIZE_MB=50
MAX_URL_CONTENT_MB=10
MAX_DOCX_ENTRIES=2000
MAX_DOCX_TOTAL_UNCOMPRESSED_MB=100
MAX_DOCX_SINGLE_ENTRY_MB=20
MAX_DOCX_COMPRESSION_RATIO=200
MAX_PDF_PAGES=300
MAX_EXTRACTED_TEXT_CHARS=1000000
TASK_STALE_MINUTES=60
MAX_GENERATION_CHUNKS=100
MAX_GENERATED_QUESTIONS=500
MAX_ACTIVE_GENERATION_TASKS=2
MAX_CONCURRENT_GENERATION_TASKS=1
MAX_DAILY_GENERATION_TASKS=10
MIN_GENERATION_INTERVAL_SECONDS=30
GENERATION_TIMEOUT_SECONDS=1800
GENERATION_BATCH_TIMEOUT_SECONDS=180
GENERATION_BATCH_MAX_RETRIES=2
MIN_PARTIAL_GENERATED_QUESTIONS=5
GENERATION_CHUNK_SIZE=1500
GENERATION_CHUNK_OVERLAP=150
GENERATION_CHUNK_CONCURRENCY=3

# 持久化出题队列。Redis 密码含特殊字符时必须先 URL 编码。
GENERATION_QUEUE_MODE=arq
REDIS_URL=redis://:<CHANGE_ME_REDIS密码>@127.0.0.1:6379/0
ARQ_QUEUE_NAME=quizapp:generation

# CORS：生产必须为明确域名列表，不能是 *
ALLOWED_ORIGINS=https://servicewechat.com
